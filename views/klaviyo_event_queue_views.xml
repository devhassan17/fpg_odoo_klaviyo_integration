<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="klaviyo_event_queue_form_view" model="ir.ui.view">
        <field name="name">fpg.odoo.klaviyo.integration.event.queue.form</field>
        <field name="model">fpg.odoo.klaviyo.integration.event.queue</field>
        <field name="arch" type="xml">
            <form string="Klaviyo Event Logs">
                <sheet>
                    <group name="klaviyo_event_queue_header" col="2">
                        <group>
                            <field name="order_id"/>
                            <field name="create_date" string="Creation Date" widget="date"/>
                            <field name="state"
                                decoration-success="state == 'sent'"
                                decoration-info="state == 'waiting'"
                                decoration-danger="state == 'canceled'"
                                widget="badge"/>
                            <field name="retries"/>
                        </group>
                        <group>
                            <field name="transaction_id"/>
                            <field name="payment_method_id"/>
                            <field name="provider_id"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <group name="klaviyo_event_queue_footer">
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="klaviyo_event_queue_tree_view" model="ir.ui.view">
        <field name="name">fpg.odoo.klaviyo.integration.event.queue.tree</field>
        <field name="model">fpg.odoo.klaviyo.integration.event.queue</field>
        <field name="arch" type="xml">
            <list string="Klaviyo Event Logs" sample="1">
                <field name="order_id"/>
                <field name="payment_method_id"/>
                <field name="provider_id"/>
                <field name="partner_id"/>
                <field name="create_date" string="Creation Date" widget="date"/>
                <field name="state"
                    decoration-success="state == 'sent'"
                    decoration-info="state == 'waiting'"
                    decoration-danger="state == 'canceled'"
                    widget="badge"/>
                <field name="retries"/>
            </list>
        </field>
    </record>

    <record id="klaviyo_event_queue_filter_view" model="ir.ui.view">
        <field name="name">fpg.odoo.klaviyo.integration.event.queue.filter</field>
        <field name="model">fpg.odoo.klaviyo.integration.event.queue</field>
        <field name="arch" type="xml">
            <search string="Klaviyo Event Logs">
                <field name="order_id"/>
                <separator/>
                <filter string="Waiting" name="waiting" domain="[('state','=','waiting')]"/>
                <filter string="Sent" name="sent" domain="[('state','=','sent')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','waiting')]"/>
                
                <separator string="Group By"/>
                <group>
                    <filter name="filter_to_state" string="Status" domain="[]" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="klaviyo_event_queue_form_action" model="ir.actions.act_window">
        <field name="name">Klaviyo Event Logs</field>
        <field name="res_model">fpg.odoo.klaviyo.integration.event.queue</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
