<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_partner_view_form_klaviyo" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.klaviyo</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lang']" position="after">
                <field name="klaviyo_marketing_opt_in" widget="boolean_toggle"/>
                <button name="action_test_klaviyo_subscription"
                        type="object"
                        string="Test Klaviyo Subscription"
                        class="btn-link"
                        icon="fa-flask"
                        invisible="not email"/>
            </xpath>
            <xpath expr="//page[last()]" position="after">
                <page string="Klaviyo" name="klaviyo_debug">
                    <group>
                        <field name="klaviyo_subscription_log" readonly="1" widget="text"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
